{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "YouTube Music",
  "version": "0.1.2",
  "identifier": "com.carter.youtube-music",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "YouTube Music",
        "url": "index.html",
        "width": 1280,
        "height": 820,
        "minWidth": 920,
        "minHeight": 620,
        "center": true,
        "resizable": true,
        "fullscreen": false,
        "incognito": false,
        "focus": true,
        "decorations": true,
        "hiddenTitle": false,
        "theme": null
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "category": "Music",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0"
    }
  }
}
